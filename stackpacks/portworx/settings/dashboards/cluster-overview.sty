      variables:
      - kind: ListVariable
        spec:
          plugin:
            kind: MetricLabelValues
            spec:
              labelName: k8s_cluster_name
              matchers:
              - px_cluster_status_size
          sort: alphabetical-asc
          allowMultiple: false
          allowAllValue: false
          name: cluster
          display:
            name: Cluster
            description: Kubernetes cluster
      - kind: ListVariable
        spec:
          plugin:
            kind: MetricPromQL
            spec:
              labelName: cluster
              expr: px_cluster_status_size{k8s_cluster_name="${cluster}"}
          sort: alphabetical-asc
          allowMultiple: false
          allowAllValue: false
          name: pxcluster
          display:
            name: Portworx cluster
            description: Portworx StorageCluster
