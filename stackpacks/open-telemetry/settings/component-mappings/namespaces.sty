nodes:
  - _type: "OtelComponentMapping"
    name: "OTel Service Namespace"
    description: "Represents a logical service namespace"
    identifier: "urn:stackpack:open-telemetry:otel-component-mapping:namespace"
    input:
      signal:
        - "TRACES"
        - "METRICS"
      resource:
        action: "'CREATE'"
        condition: >-
          ('service.name' in resource.attributes && resource.attributes['service.name'] != '') ||
          ('service.namespace' in resource.attributes && resource.attributes['service.namespace'] != '')
    vars:
      - name: "namespace"
        value: >-
          'service.namespace' in resource.attributes &&
          resource.attributes['service.namespace'] != '' ?
          resource.attributes['service.namespace'] :
          'default'
    output:
      identifier: "'urn:opentelemetry:namespace/' + vars.namespace"
      name: "vars.namespace"
      typeName: "'service namespace (otel)'"
      required:
        tags:
          - source: "'open-telemetry'"
            target: "stackpack"
      optional:
        tags:
          - source: "resource.attributes['deployment.environment']"
            target: "deployment-environment"
          - source: >-
              'k8s.cluster.name' in resource.attributes && resource.attributes['k8s.cluster.name'] != '' ?
              {'cluster-name': resource.attributes['k8s.cluster.name']} : {}
            pattern: "(.*)"
            target: "${1}"
          - source: >-
              'k8s.cluster.name' in resource.attributes && resource.attributes['k8s.cluster.name'] != '' &&
              'k8s.namespace.name' in resource.attributes && resource.attributes['k8s.namespace.name'] != '' ?
              {'k8s-scope': resource.attributes['k8s.cluster.name'] + '/' + resource.attributes['k8s.namespace.name']} : {}
            pattern: "(.*)"
            target: "${1}"
          - source: >-
              'k8s.namespace.name' in resource.attributes && resource.attributes['k8s.namespace.name'] != '' ?
              {'namespace': resource.attributes['k8s.namespace.name']} : {}
            pattern: "(.*)"
            target: "${1}"
    expireAfter: 900000
    rank:
      specificity: 100
