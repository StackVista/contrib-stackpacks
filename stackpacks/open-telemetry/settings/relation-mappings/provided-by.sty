nodes:
  - _type: "OtelRelationMapping"
    name: "OTel service instance provided-by service relation"
    description: "Links a service to its instance"
    identifier: "urn:stackpack:open-telemetry:otel-relation-mapping:provided-by"
    input:
      signal:
        - "TRACES"
        - "METRICS"
      resource:
        action: "'CREATE'"
        condition: "'service.name' in resource.attributes"
    vars:
      # OTel: service.name is required, service.namespace is optional; unset or empty means "no namespace", not a default one.
      # service.instance.id is unique only within its (service.namespace, service.name) pair: https://opentelemetry.io/docs/specs/semconv/registry/attributes/service/
      - name: "serviceUrnPrefix"
        value: >-
          'service.namespace' in resource.attributes &&
          resource.attributes['service.namespace'] != '' ?
          'urn:opentelemetry:namespace/' + resource.attributes['service.namespace'] + ':service/' :
          'urn:opentelemetry:service/'
      - name: "service"
        value: "resource.attributes['service.name']"
      - name: "instanceId"
        value: >-
          'service.instance.id' in resource.attributes ?
          resource.attributes['service.instance.id'] :
          resource.attributes['service.name']
    output:
      sourceId: >-
        vars.serviceUrnPrefix + vars.service
      targetId: >-
        vars.serviceUrnPrefix + vars.service + ':serviceInstance/' + vars.instanceId
      typeName: "'provided-by'"
      dependencyType: "'HIERARCHICAL'"
    expireAfter: 900000
