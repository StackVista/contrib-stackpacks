nodes:
  - _type: Monitor
    arguments:
      comparator: GT
      failureState: DEVIATING
      metric:
        query: |-
          label_replace(label_replace(
            sum by(service_namespace, service_name, service_instance_id)(rate(otel_span_calls_total{status_code="STATUS_CODE_ERROR", span_kind=~"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER"}[5m]) or (present_over_time(otel_span_calls_total{span_kind=~"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER"}[5m]) -1)) / sum by(service_namespace, service_name, service_instance_id)(rate(otel_span_calls_total{span_kind=~"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER"}[5m])) * 100
          , "urn_prefix", "urn:opentelemetry:service/", "service_namespace", "")
          , "urn_prefix", "urn:opentelemetry:namespace/$1:service/", "service_namespace", "(.+)")
        aliasTemplate: Error ratio (errors/total)
        unit: percent
      threshold: 5
      titleTemplate: Span error ratio
      # OTel: service.namespace is optional; series without it belong to a service with no namespace, not a default one.
      # service.instance.id is unique only within its (service.namespace, service.name) pair: https://opentelemetry.io/docs/specs/semconv/registry/attributes/service/
      urnTemplate: "${urn_prefix}${service_name}:serviceInstance/${service_instance_id}"
    description: |
      Percentage of server and consumer spans that are in an error state for the service instance.
    function: urn:stackpack:common:monitor-function:threshold
    identifier: urn:stackpack:open-telemetry:monitor:otel-service-instance-span-error-ratio
    intervalSeconds: 30
    name: Span error ratio for Open Telemetry service instances
    status: ENABLED
    tags: ["service", "traces"]
    remediationHint: !include remediation-hints/service-instance-span-error-ratio.md.hbs